APP_PORT=8032
ENV=development
# docker-compose maps Postgres to host port 5434
DATABASE_URL=postgres://arcus:arcus@localhost:5434/arcusinvest?sslmode=disable
JWT_SECRET=change-this-to-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Public URL of the frontend; used to build invitation claim links.
# Optional in development (defaults to http://localhost:5173), REQUIRED in production.
FRONTEND_URL=http://localhost:5173
SEED_ADMIN_NAME=John Katepa
SEED_ADMIN_EMAIL=john.katepa@arcusinvest-zm.com
SEED_ADMIN_PASSWORD=ArcusAdmin#2026

# AI assistant (Google Gemini). Leave AI_API_KEY empty to serve the local
# knowledge base instead of calling the provider.
AI_PROVIDER_URL=https://generativelanguage.googleapis.com
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# SMTP for event broadcasts. All optional; if unset, broadcasts are stored as
# 'queued' but not emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
