APP_PORT=8032
ENV=development
# docker-compose maps Postgres to host port 5434
DATABASE_URL=postgres://arcus:arcus@localhost:5434/arcusinvest?sslmode=disable
JWT_SECRET=change-this-to-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Public URL of the frontend; used to build invitation claim links.
# Optional in development (defaults to http://localhost:5173), REQUIRED in production.
FRONTEND_URL=http://localhost:5173
SEED_ADMIN_NAME=John Katepa
SEED_ADMIN_EMAIL=john.katepa@arcusinvest-zm.com
SEED_ADMIN_PASSWORD=ArcusAdmin#2026

# AI assistant (Anthropic Claude). Leave AI_API_KEY empty to serve the local
# knowledge base instead of calling the provider.
AI_PROVIDER_URL=https://api.anthropic.com
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Outbound email (student onboarding invitations and event broadcasts) ---
# Two transports are supported. Resend is tried first when RESEND_API_KEY is set;
# otherwise SMTP is used. With neither, invitation links must be shared manually
# and broadcasts stay 'queued'.
# Verify either one with: Admin portal → Users → "Send test email" (goes only to yourself).

# The sender address, used by both transports. Must be an address the provider
# lets you send from. (SMTP_FROM is still read as a fallback for older deploys.)
MAIL_FROM=onboarding@arcusinvest-zm.com

# Option A — Resend HTTPS API. REQUIRED on hosts that block outbound SMTP:
# Railway blocks ports 25/465/587 on the Free, Trial and Hobby plans, where SMTP
# presents as a connection timeout no matter what settings you use.
# Get a key at resend.com/api-keys, and verify your sending domain at
# resend.com/domains — until you do, mail can only reach your own account address.
RESEND_API_KEY=

# Option B — SMTP. Only works where outbound SMTP ports are open.
# PORT: use 587 (STARTTLS) or 465 (implicit TLS) — both are supported.
# Port 25 is blocked outbound by most hosts and will present as a timeout.
# For Gmail, SMTP_PASSWORD must be an App Password, not your account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
